# =============================================================================
# CaduTrack frontend environment variables
# Copy this file to .env.local and adjust if needed
#   cp .env.example .env.local
# =============================================================================

# Base URL of the FastAPI backend.
# Leave it unset to use the relative "/api" path, which the Vite dev server
# proxies to http://localhost:8000 and which the reverse proxy serves in
# production. Set it only when the API lives somewhere else.
# VITE_API_URL=http://localhost:8001
